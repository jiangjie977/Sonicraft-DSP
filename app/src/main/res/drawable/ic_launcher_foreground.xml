<?xml version="1.0" encoding="utf-8"?>
<!-- C5 · 柱 + 中心光晕
     在 6 根柱（逐根按系统录音机实测定位）背后叠一层青色径向光晕，
     像 VU 表背光；光晕用 radial gradient（中心 #22D3EE 30% -> 边缘 0）。
     底板仍为 #2D3137（见 ic_launcher_background）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 光晕 -->
    <path android:pathData="M54,54 m-46,0 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46">
                <item android:offset="0" android:color="#4D22D3EE" />
                <item android:offset="0.55" android:color="#1A22D3EE" />
                <item android:offset="1" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 柱1 -->
    <path
        android:pathData="M36.5,50.6 L36.5,57.4"
        android:strokeColor="#FFF5F5F5"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />

    <!-- 柱2 -->
    <path
        android:pathData="M43.8,44.4 L43.8,63.6"
        android:strokeColor="#FFF5F5F5"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />

    <!-- 柱3（峰值红） -->
    <path
        android:pathData="M50.6,38.6 L50.6,69.4"
        android:strokeColor="#FFF35458"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />

    <!-- 柱4 -->
    <path
        android:pathData="M57.4,47.5 L57.4,60.5"
        android:strokeColor="#FFF5F5F5"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />

    <!-- 柱5（电平黄） -->
    <path
        android:pathData="M64.2,43.3 L64.2,64.7"
        android:strokeColor="#FFFFB300"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />

    <!-- 柱6 -->
    <path
        android:pathData="M71,49.6 L71,58.4"
        android:strokeColor="#FFF5F5F5"
        android:strokeWidth="3.13"
        android:strokeLineCap="round" />
</vector>
